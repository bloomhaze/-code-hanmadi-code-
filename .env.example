# Supabase credentials — copy this file to `.env` and fill in your values.
# Find them in your Supabase project: Settings → API.
# Only VITE_-prefixed vars are exposed to the client bundle.
# The anon/publishable key is safe to ship to the browser; never put a
# service_role/secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
